# true: no RPC calls at all. false: write to the local Besu node.
DRY_RUN=true
MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# Sector_A laptop (hydro-node2): http://127.0.0.1:8546
# Sector_B laptop (hydro-node3) and Sector_C laptop (hydro-node4): http://127.0.0.1:8545
# Do not point a sector at hydro-node1.
RPC_URL=http://127.0.0.1:8545

# This laptop's reporter wallet from hydro-contracts/scripts/make-wallets.js.
# Never use a validator key from besu-net/nodeN/key.
# Leave blank in dry run. In live mode set PRIVATE_KEY, or KEYSTORE_PATH and KEYSTORE_PASSWORD.
PRIVATE_KEY=
# KEYSTORE_PATH=
# KEYSTORE_PASSWORD=

CONTRACT_ADDRESS=
TELEMETRY_CONTRACT_ADDRESS=

# One of Sector_A, Sector_B, Sector_C. One aggregator process per laptop.
SECTOR_ID=Sector_B
UPSTREAM_NODE_ID=Upstream_Master
EXPECTED_DOWNSTREAM=Sector_B

# Used only when the chain cannot be read.
LEAK_THRESHOLD=5.0
DAILY_QUOTA_LIMIT=5000
DAY_OFFSET_SECONDS=0

EVAL_INTERVAL_SEC=2
STALE_AFTER_SEC=10
BREACH_CONSECUTIVE=2
SNAPSHOT_INTERVAL_MIN=10
CHAIN_POLL_SEC=30
STATE_DIR=./state

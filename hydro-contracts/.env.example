# Owner wallet on laptop A. Create with: node scripts/make-wallets.js
# Never paste a validator key from besu-net/nodeN/key.
OWNER_PRIVATE_KEY=

# Laptop A deploy target. http://127.0.0.1:8545 (hydro-node1 RPC) is fine for deploy.
# Sector_A's aggregator must use http://127.0.0.1:8546 instead. This file is not that aggregator.
RPC_URL=http://127.0.0.1:8545

REPORTER_ADDRESS_A=
REPORTER_ADDRESS_B=
REPORTER_ADDRESS_C=

INITIAL_QUOTA_LITERS_A=5000
INITIAL_QUOTA_LITERS_B=5000
INITIAL_QUOTA_LITERS_C=5000

MIN_SNAPSHOT_INTERVAL_SECONDS=540

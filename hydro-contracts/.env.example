# Owner wallet on laptop A. Create with: node scripts/make-wallets.js
# Never paste a validator key from besu-net/nodeN/key.
OWNER_PRIVATE_KEY=

# Laptop A deploy target. http://127.0.0.1:8545 (hydro-node1 RPC) is fine for deploy.
# Sector_A's aggregator must use http://127.0.0.1:8546 instead. This file is not that aggregator.
RPC_URL=http://127.0.0.1:8545

REPORTER_ADDRESS_A=
REPORTER_ADDRESS_B=
REPORTER_ADDRESS_C=

INITIAL_QUOTA_LITERS_A=5000
INITIAL_QUOTA_LITERS_B=5000
INITIAL_QUOTA_LITERS_C=5000

# Telemetry snapshot floor. Aggregator posts every 4 minutes (240 s); keep this a bit below that.
MIN_SNAPSHOT_INTERVAL_SECONDS=210

# One quota "day" lasts this many seconds (600 = a day passes every 10 minutes). Fixed at deploy.
# Force a new day at any time with: npm run advance-day
DAY_LENGTH_SECONDS=600

# Only for a laptop that just READS (read-sector.js) and has no deployments/besu.json.
# Same names as the aggregator's .env. Not needed on laptop A after deploy.
# CONTRACT_ADDRESS=
# TELEMETRY_CONTRACT_ADDRESS=
